<Window x:Class="ToolDock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="工具坞 ToolDock"
        Icon="pack://application:,,,/app.ico"
        Width="1040" Height="700" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <!--
      VigilWatt 同款窗口结构：48px 融入式标题栏 + 左侧导航。
      CaptionHeight=48 让整条标题栏可拖拽；GlassFrameThickness=-1 把 DWM 材质铺满全窗，
      Mica 生效时 Root 保持透明，失败时代码里回退纯色。
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="-1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="True" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="{DynamicResource Bg.Solid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏融入区：背景透明让材质透出，标题靠左，右上留给系统按钮 -->
        <Grid Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                        IsHitTestVisible="False">
                <Image Source="pack://application:,,,/app.ico" Width="16" Height="16" />
                <TextBlock Text="工具坞"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource Text.Primary}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="168" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 侧边导航：对齐 VigilWatt NavigationView（PaneDisplayMode=Left, OpenPaneLength=160） -->
            <Border Grid.Column="0" Background="{DynamicResource Side.Background}">
                <Grid Margin="0,4,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <!-- 首页：默认启动页 -->
                        <RadioButton Style="{StaticResource NavItemStyle}"
                                     GroupName="Nav"
                                     Tag="&#xE80F;" Content="首页"
                                     CommandParameter="home"
                                     IsChecked="True"
                                     Checked="Nav_Checked" />
                        <!-- 方案 A「分组固定」：分组文本将来由插件 category 字段驱动 -->
                        <TextBlock Text="监控" Style="{StaticResource NavGroupStyle}" />
                        <RadioButton Style="{StaticResource NavItemStyle}"
                                     GroupName="Nav"
                                     Tag="&#xE702;" Content="设备电量"
                                     CommandParameter="battery"
                                     Checked="Nav_Checked" />
                        <TextBlock Text="系统" Style="{StaticResource NavGroupStyle}" />
                        <RadioButton Style="{StaticResource NavItemStyle}"
                                     GroupName="Nav"
                                     Tag="&#xE74D;" Content="内存清理"
                                     CommandParameter="memclean"
                                     Checked="Nav_Checked" />
                    </StackPanel>

                    <!-- 底部固定区：设置 / 关于 永远在最下（NavigationView FooterMenuItems 观感） -->
                    <StackPanel Grid.Row="2">
                        <Border Height="1" Margin="12,8,12,4" Background="{DynamicResource Divider}" />
                        <RadioButton Style="{StaticResource NavItemStyle}"
                                     GroupName="Nav"
                                     Tag="&#xE713;" Content="设置"
                                     CommandParameter="settings"
                                     Checked="Nav_Checked" />
                        <RadioButton Style="{StaticResource NavItemStyle}"
                                     GroupName="Nav"
                                     Tag="&#xE946;" Content="关于"
                                     CommandParameter="about"
                                     Checked="Nav_Checked" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 内容区：半透明层叠色（侧边栏透明，内容区有色） -->
            <Border Grid.Column="1" Background="{DynamicResource Content.Background}">
                <ContentControl x:Name="PageHost" />
            </Border>
        </Grid>
    </Grid>
</Window>
