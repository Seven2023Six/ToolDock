<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      深色调色板：对齐 WinUI 深色令牌的近似值（VigilWatt 同源观感）。
      卡片/侧边栏用半透明白，Mica 材质能透出来；Mica 失败时回退 Bg.Solid 纯色。
    -->
    <SolidColorBrush x:Key="Bg.Solid" Color="#FF202020" />
    <SolidColorBrush x:Key="Side.Background" Color="#B33A3A3A" />
    <SolidColorBrush x:Key="Card.Background" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Card.Stroke" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Divider" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Nav.Hover" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Nav.Checked" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Ctrl.Background" Color="#1FFFFFFF" />

    <SolidColorBrush x:Key="Text.Primary" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#FFC9C9C9" />
    <SolidColorBrush x:Key="Text.Tertiary" Color="#FF8A8A8A" />

    <SolidColorBrush x:Key="Accent" Color="#FF4CC2FF" />
    <SolidColorBrush x:Key="Accent.Foreground" Color="#FF001824" />
    <SolidColorBrush x:Key="Accent.Hover" Color="#FF63CCFF" />
    <SolidColorBrush x:Key="Accent.Pressed" Color="#FF38AEF5" />

    <SolidColorBrush x:Key="Btn.Background" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="Btn.Background.Hover" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Btn.Background.Pressed" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="Btn.Stroke" Color="#1FFFFFFF" />
</ResourceDictionary>
