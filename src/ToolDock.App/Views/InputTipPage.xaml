<UserControl x:Class="ToolDock.App.Views.InputTipPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="20,16,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button Click="Back_Click" Cursor="Hand" Focusable="False"
                            Background="Transparent" BorderThickness="0" Padding="6,2"
                            Content="‹ 返回" FontSize="13"
                            Foreground="{DynamicResource Text.Secondary}" />
                    <TextBlock Text="输入法状态提示" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="内置输入法提示引擎 1.0（基于 InputTip）· 进程内运行 · 无 AutoHotkey 进程与独立托盘"
                           Style="{StaticResource PageSubtitleStyle}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock x:Name="StatusText" Text="检查中…" FontSize="13"
                           Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 引擎开关 -->
        <Border Grid.Row="1" Margin="20,10,20,0" Style="{StaticResource SettingsCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,12" VerticalAlignment="Center">
                    <TextBlock Text="启用输入法状态提示" Style="{StaticResource RowTitleStyle}" />
                    <TextBlock Text="引擎随工具箱后台运行；关闭后立即隐藏提示并恢复系统光标，配置保留"
                               Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="ConfigPathText" Text="—" FontSize="11" Margin="0,6,0,0"
                               Foreground="{DynamicResource Text.Secondary}"
                               TextTrimming="CharacterEllipsis" MaxWidth="760" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,12" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button x:Name="PauseButton" Content="暂停" Style="{StaticResource AppButtonStyle}"
                            Click="Pause_Click" Margin="0,0,10,0"
                            AutomationProperties.AutomationId="InputTip_Pause" />
                    <TextBlock Text="引擎 " FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Secondary}" />
                    <TextBlock x:Name="VersionText" Text="1.0" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Secondary}" />
                    <ToggleButton x:Name="ToolEnabledToggle" Margin="14,0,0,0"
                                  Style="{StaticResource SwitchStyle}" Click="ToolEnabled_Changed"
                                  VerticalAlignment="Center"
                                  AutomationProperties.AutomationId="InputTip_Enabled" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="EditorArea" Grid.Row="2" Margin="20,10,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                <RadioButton Content="常规" Tag="General" GroupName="InputTipTab" Style="{StaticResource SubTabStyle}"
                             IsChecked="True" Checked="Tab_Checked" />
                <RadioButton Content="输入法" Tag="Ime" GroupName="InputTipTab" Style="{StaticResource SubTabStyle}" Checked="Tab_Checked" />
                <RadioButton Content="鼠标样式" Tag="Cursor" GroupName="InputTipTab" Style="{StaticResource SubTabStyle}" Checked="Tab_Checked" />
                <RadioButton Content="悬浮小窗" Tag="Overlay" GroupName="InputTipTab" Style="{StaticResource SubTabStyle}" Checked="Tab_Checked" />
                <RadioButton Content="光标符号" Tag="Caret" GroupName="InputTipTab" Style="{StaticResource SubTabStyle}" Checked="Tab_Checked" />
                <RadioButton Content="鼠标符号" Tag="CursorSymbol" GroupName="InputTipTab" Style="{StaticResource SubTabStyle}" Checked="Tab_Checked" />
                <RadioButton Content="窗口边框" Tag="Border" GroupName="InputTipTab" Style="{StaticResource SubTabStyle}" Checked="Tab_Checked" />
                <RadioButton Content="规则" Tag="Rules" GroupName="InputTipTab" Style="{StaticResource SubTabStyle}" Checked="Tab_Checked" />
                <RadioButton Content="更多" Tag="More" GroupName="InputTipTab" Style="{StaticResource SubTabStyle}" Checked="Tab_Checked" />
            </WrapPanel>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="GeneralPane" Focusable="False" FocusVisualStyle="{x:Null}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4,4,8">
                    <StackPanel x:Name="GeneralHost" />
                </ScrollViewer>
                <ScrollViewer x:Name="ImePane" Focusable="False" FocusVisualStyle="{x:Null}" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4,4,8">
                    <StackPanel x:Name="ImeHost" />
                </ScrollViewer>
                <ScrollViewer x:Name="CursorPane" Focusable="False" FocusVisualStyle="{x:Null}" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4,4,8">
                    <StackPanel x:Name="CursorHost" />
                </ScrollViewer>
                <ScrollViewer x:Name="OverlayPane" Focusable="False" FocusVisualStyle="{x:Null}" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4,4,8">
                    <StackPanel x:Name="OverlayHost" />
                </ScrollViewer>
                <ScrollViewer x:Name="CaretPane" Focusable="False" FocusVisualStyle="{x:Null}" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4,4,8">
                    <StackPanel x:Name="CaretHost" />
                </ScrollViewer>
                <ScrollViewer x:Name="CursorSymbolPane" Focusable="False" FocusVisualStyle="{x:Null}" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4,4,8">
                    <StackPanel x:Name="CursorSymbolHost" />
                </ScrollViewer>
                <ScrollViewer x:Name="BorderPane" Focusable="False" FocusVisualStyle="{x:Null}" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4,4,8">
                    <StackPanel x:Name="BorderHost" />
                </ScrollViewer>
                <ScrollViewer x:Name="RulesPane" Focusable="False" FocusVisualStyle="{x:Null}" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4,4,8">
                    <StackPanel x:Name="RulesHost" />
                </ScrollViewer>
                <ScrollViewer x:Name="MorePane" Focusable="False" FocusVisualStyle="{x:Null}" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4,4,8">
                    <StackPanel x:Name="MoreHost" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 底部操作 -->
        <Grid Grid.Row="3" Margin="20,10,20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="SaveButton" Content="应用并重启引擎" Style="{StaticResource PrimaryButtonStyle}"
                        Click="Save_Click" />
                <Button Content="恢复默认配置" Style="{StaticResource AppButtonStyle}" Margin="8,0,0,0"
                        Click="Reset_Click" />
                <Button Content="打开配置目录" Style="{StaticResource AppButtonStyle}" Margin="8,0,0,0"
                        Click="OpenConfig_Click" />
            </StackPanel>
            <TextBlock x:Name="SaveStatus" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"
                       FontSize="13" Foreground="{DynamicResource Text.Secondary}" />
        </Grid>
    </Grid>
</UserControl>
