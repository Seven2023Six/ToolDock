<UserControl x:Class="ToolDock.App.Views.MemCleanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,16,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button Click="Back_Click" Cursor="Hand" Focusable="False"
                            Background="Transparent" BorderThickness="0" Padding="6,2"
                            Content="‹ 返回" FontSize="13"
                            Foreground="{DynamicResource Text.Secondary}" />
                    <TextBlock Text="内存清理" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="SummaryText" Text="—" Style="{StaticResource PageSubtitleStyle}" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="CleanButton" Style="{StaticResource PrimaryButtonStyle}"
                    Click="CleanNow_Click" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource GlyphTextBlockStyle}" FontSize="14"
                               VerticalAlignment="Center" />
                    <TextBlock Text="立即清理" FontSize="14" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
        </Grid>

            <!-- 工具开关（决定是否出现在「内置工具」里可用） -->
        <Border Grid.Row="1" Margin="20,12,20,0" Style="{StaticResource SettingsCardStyle}">
                <Grid Margin="0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="启用内存清理工具" Style="{StaticResource RowTitleStyle}" />
                        <TextBlock Text="停用后「内置工具」里该卡片显示为已停用" Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" />
                    </StackPanel>
                    <ToggleButton x:Name="ToolEnabledToggle" Grid.Column="1" Style="{StaticResource SwitchStyle}"
                                  Checked="ToolEnabled_Changed" Unchecked="ToolEnabled_Changed"
                                  VerticalAlignment="Center" />
                </Grid>
            </Border>


        <ScrollViewer Grid.Row="2" x:Name="ToolContent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" FocusVisualStyle="{x:Null}">
            <StackPanel Margin="20,16,20,16">

                <!-- 单条整体内存 -->
                <Border Style="{StaticResource CardStyle}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="内存使用率" Style="{StaticResource CardLabelStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="UsageText" Text="—" FontSize="30" FontWeight="Bold"
                                       Foreground="{DynamicResource Text.Primary}" />
                            <TextBlock Text="%" FontSize="14" FontWeight="SemiBold" Margin="2,10,0,0"
                                       Foreground="{DynamicResource Text.Primary}" />
                        </StackPanel>
                        <Border Height="6" CornerRadius="3" Background="{DynamicResource Nav.Checked}" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="UsedColumn" Width="0*" />
                                    <ColumnDefinition x:Name="FreeColumn" Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="3" Background="{DynamicResource Accent}" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="MemFootnoteText" Text="已用 — / — GB"
                                   Style="{StaticResource CardFootnoteStyle}" Margin="0,6,0,0" />
                        <TextBlock x:Name="GroupsText" Text="页面文件 — · 系统缓存 —"
                                   Style="{StaticResource CardFootnoteStyle}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- 清理区域 -->
                <TextBlock Text="清理区域" Style="{StaticResource SectionTitleStyle}" Margin="2,16,0,8" />
                <Border Style="{StaticResource SettingsCardStyle}" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <CheckBox Style="{StaticResource WinUICheckBoxStyle}" x:Name="CbWorkingSet" Content="工作集" Margin="0,4" Checked="Region_Changed" Unchecked="Region_Changed" />
                            <CheckBox Style="{StaticResource WinUICheckBoxStyle}" x:Name="CbSystemFileCache" Content="系统文件缓存" Margin="0,4" Checked="Region_Changed" Unchecked="Region_Changed" />
                            <CheckBox Style="{StaticResource WinUICheckBoxStyle}" x:Name="CbModifiedList" Content="已修改页面列表 *" Margin="0,4" Checked="Region_Changed" Unchecked="Region_Changed" />
                            <CheckBox Style="{StaticResource WinUICheckBoxStyle}" x:Name="CbStandbyList" Content="备用列表 *" Margin="0,4" Checked="Region_Changed" Unchecked="Region_Changed" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <CheckBox Style="{StaticResource WinUICheckBoxStyle}" x:Name="CbStandbyPriority0" Content="备用列表（无优先级）" Margin="0,4" Checked="Region_Changed" Unchecked="Region_Changed" />
                            <CheckBox Style="{StaticResource WinUICheckBoxStyle}" x:Name="CbModifiedFileCache" Content="已修改文件缓存" Margin="0,4" Checked="Region_Changed" Unchecked="Region_Changed" />
                            <CheckBox Style="{StaticResource WinUICheckBoxStyle}" x:Name="CbRegistryCache" Content="注册表缓存" Margin="0,4" Checked="Region_Changed" Unchecked="Region_Changed" />
                            <CheckBox Style="{StaticResource WinUICheckBoxStyle}" x:Name="CbCombineLists" Content="合并内存列表" Margin="0,4" Checked="Region_Changed" Unchecked="Region_Changed" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 自动清理 -->
                <TextBlock Text="自动清理" Style="{StaticResource SectionTitleStyle}" Margin="2,16,0,8" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="占用超过阈值时清理" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="阈值 %（50-99）" Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="ThresholdBox" Width="52" Height="32" Text="90" Style="{StaticResource WinUITextBoxStyle}" />
                                <ToggleButton x:Name="ThresholdToggle" Style="{StaticResource SwitchStyle}"
                                              Checked="AutoClean_Changed" Unchecked="AutoClean_Changed" Margin="12,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="定时清理" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="间隔分钟（5-720）" Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="IntervalBox" Width="52" Height="32" Text="30" Style="{StaticResource WinUITextBoxStyle}" />
                                <ToggleButton x:Name="IntervalToggle" Style="{StaticResource SwitchStyle}"
                                              Checked="AutoClean_Changed" Unchecked="AutoClean_Changed" Margin="12,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="自动清理时包含冻结区" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="勾选后自动清理也处理备用列表 / 已修改页面列表" Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="AllowFreezesToggle" Style="{StaticResource SwitchStyle}"
                                          Click="AllowFreezes_Click" VerticalAlignment="Center" />
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="清理前确认" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="手动清理前列出所选区域并请求确认" Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="ConfirmCleanToggle" Style="{StaticResource SwitchStyle}"
                                          Click="ConfirmClean_Click" VerticalAlignment="Center" />
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="免 UAC 提权" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="通过计划任务静默执行清理，不弹 UAC" Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="SkipUacToggle" Style="{StaticResource SwitchStyle}"
                                          Click="SkipUac_Click" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 提示与日志 -->
                <TextBlock Text="提示与日志" Style="{StaticResource SectionTitleStyle}" Margin="2,16,0,8" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="清理后弹气泡提示" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="显示本次释放的内存量" Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="BubbleToggle" Grid.Column="1" Style="{StaticResource SwitchStyle}"
                                          Click="Bubble_Click" VerticalAlignment="Center" />
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="把清理结果写入日志" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="每次清理记录释放量与失败区域" Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="LogResultsToggle" Grid.Column="1" Style="{StaticResource SwitchStyle}"
                                          Click="LogResults_Click" VerticalAlignment="Center" />
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="全局热键清理" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="任意程序前台时按组合键直接清理，不弹确认" Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ComboBox x:Name="HotkeyBox" Grid.Column="1" Width="160" Height="32"
                                      VerticalContentAlignment="Center" SelectionChanged="Hotkey_Changed">
                                <ComboBoxItem Content="关闭" />
                                <ComboBoxItem Content="Ctrl + F1" />
                                <ComboBoxItem Content="Ctrl + Alt + M" />
                                <ComboBoxItem Content="Ctrl + Shift + F9" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 重置 -->
                <TextBlock Text="重置" Style="{StaticResource SectionTitleStyle}" Margin="2,16,0,8" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid Margin="0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="恢复默认设置" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="区域回到默认 0xE7，自动清理关闭，阈值 90、间隔 30 分" Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="恢复默认" MinWidth="96" Height="32" Padding="12,0"
                                Style="{StaticResource AppButtonStyle}" Click="ResetDefaults_Click" />
                    </Grid>
                </Border>

                <!-- 任务栏贴片 -->
                <TextBlock Text="任务栏贴片" Style="{StaticResource SectionTitleStyle}" Margin="2,16,0,8" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="在任务栏显示内存贴片" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="显示当前内存占用，点击贴片即可清理；与电量贴片并排分隔显示"
                                           Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="MemoryPillToggle" Style="{StaticResource SwitchStyle}"
                                          Checked="MemoryPill_Changed" Unchecked="MemoryPill_Changed"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
