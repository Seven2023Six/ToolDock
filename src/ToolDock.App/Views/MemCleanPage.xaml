<UserControl x:Class="ToolDock.App.Views.MemCleanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 设计稿 ②：KPI + 内存构成条 + 自动清理策略（M2 接入）+ 释放历史（M2 生成） -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,16,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="内存清理" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="SummaryText" Text="—" Style="{StaticResource PageSubtitleStyle}" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False"
                    VerticalAlignment="Top" ToolTip="等待内存清理插件与提权方案定案（里程碑 M2）">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource GlyphTextBlockStyle}" FontSize="14"
                               VerticalAlignment="Center" />
                    <TextBlock Text="立即清理" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" FocusVisualStyle="{x:Null}">
            <StackPanel Margin="20,16,20,16">

                <!-- 总览卡：大百分比 + 内存构成条 -->
                <Border Style="{StaticResource CardStyle}" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="内存使用率" Style="{StaticResource CardLabelStyle}" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock x:Name="UsageText" Text="—" FontSize="26" FontWeight="Bold"
                                           Foreground="{DynamicResource Text.Primary}" />
                                <TextBlock Text="%" FontSize="14" FontWeight="SemiBold" Margin="2,10,0,0"
                                           Foreground="{DynamicResource Text.Primary}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Border Height="10" CornerRadius="5" Background="{DynamicResource Nav.Checked}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="UsedColumn" Width="0*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="5" Background="{DynamicResource Accent}" />
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                    <Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource Accent}"
                                            VerticalAlignment="Center" />
                                    <TextBlock x:Name="UsedLegendText" Text="已用 —" FontSize="11"
                                               Foreground="{DynamicResource Text.Secondary}" Margin="5,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource Nav.Checked}"
                                            VerticalAlignment="Center" />
                                    <TextBlock x:Name="FreeLegendText" Text="可用 —" FontSize="11"
                                               Foreground="{DynamicResource Text.Secondary}" Margin="5,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="自动清理" Style="{StaticResource SectionTitleStyle}" Margin="2,16,0,8" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="内存超过阈值时自动清理" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="由后台插件执行，关窗也照常工作（里程碑 M2 接入）"
                                           Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SwitchStyle}"
                                          IsChecked="False" IsEnabled="False" VerticalAlignment="Center" />
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="定时清理" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="按固定间隔执行一次（里程碑 M2 接入）"
                                           Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SwitchStyle}"
                                          IsChecked="False" IsEnabled="False" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="最近记录" Style="{StaticResource SectionTitleStyle}" Margin="2,16,0,8" />
                <Border Style="{StaticResource CardStyle}" Padding="16,14">
                    <TextBlock Text="暂无清理记录——清理功能在里程碑 M2 接入后生成历史"
                               Style="{StaticResource RowDescStyle}" />
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
