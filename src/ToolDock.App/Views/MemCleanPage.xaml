<UserControl
    x:Class="ToolDock.App.Views.MemCleanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ToolDock.App.Controls"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!--
      内存清理页：单条整体内存 + 区域勾选 + 自动清理策略（逻辑与设置页共享同一管道配置）。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader
            Grid.Row="0"
            Margin="0,0,0,24"
            Title="内存清理"
            Description="释放系统内存，与 Mem Reduct 相同的清理区域与策略" />

        <ScrollViewer Grid.Row="1" Margin="0,0,0,24" Padding="0,0,24,0">
            <StackPanel>
                <!-- 内存总览卡片 -->
                <Border
                    Margin="0,0,0,20"
                    Padding="24"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource OverlayCornerRadius}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="物理内存" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Name="SummaryText"
                                Margin="0,8,0,0"
                                Opacity="{DynamicResource DeemphasizedTextOpacity}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                            <ProgressBar
                                x:Name="UsageBar"
                                Height="8"
                                Margin="0,12,0,0"
                                Maximum="100" />
                            <TextBlock
                                x:Name="MemFootnoteText"
                                Margin="0,8,0,0"
                                Opacity="{DynamicResource DeemphasizedTextOpacity}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <Button
                            x:Name="CleanButton"
                            Grid.Column="1"
                            MinWidth="140"
                            VerticalAlignment="Center"
                            Click="CleanNow_Click"
                            Content="立即清理" />
                    </Grid>
                </Border>

                <!-- 清理区域 -->
                <TextBlock
                    Margin="10,0,0,8"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="清理区域" />
                <Border
                    Margin="0,0,0,20"
                    Padding="20,16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource OverlayCornerRadius}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <CheckBox x:Name="CbWorkingSet" Margin="0,4" Checked="Region_Changed" Content="工作集" Unchecked="Region_Changed" />
                            <CheckBox x:Name="CbSystemFileCache" Margin="0,4" Checked="Region_Changed" Content="系统文件缓存" Unchecked="Region_Changed" />
                            <CheckBox x:Name="CbModifiedList" Margin="0,4" Checked="Region_Changed" Content="已修改页面列表 *" Unchecked="Region_Changed" />
                            <CheckBox x:Name="CbStandbyList" Margin="0,4" Checked="Region_Changed" Content="备用列表 *" Unchecked="Region_Changed" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <CheckBox x:Name="CbStandbyPriority0" Margin="0,4" Checked="Region_Changed" Content="备用列表（无优先级）" Unchecked="Region_Changed" />
                            <CheckBox x:Name="CbModifiedFileCache" Margin="0,4" Checked="Region_Changed" Content="已修改文件缓存" Unchecked="Region_Changed" />
                            <CheckBox x:Name="CbRegistryCache" Margin="0,4" Checked="Region_Changed" Content="注册表缓存" Unchecked="Region_Changed" />
                            <CheckBox x:Name="CbCombineLists" Margin="0,4" Checked="Region_Changed" Content="合并内存列表" Unchecked="Region_Changed" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 自动清理 -->
                <TextBlock
                    Margin="10,0,0,8"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="自动清理" />
                <Border
                    Margin="0,0,0,20"
                    Padding="20,16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource OverlayCornerRadius}">
                    <StackPanel>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="占用超过阈值时清理" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Opacity="{DynamicResource DeemphasizedTextOpacity}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="阈值 %（50-99）" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="ThresholdBox" Width="52" Height="32" Text="90" />
                                <CheckBox x:Name="ThresholdToggle" Margin="12,0,0,0" Checked="AutoClean_Changed" Unchecked="AutoClean_Changed" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="定时清理" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Opacity="{DynamicResource DeemphasizedTextOpacity}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="间隔分钟（5-720）" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="IntervalBox" Width="52" Height="32" Text="30" />
                                <CheckBox x:Name="IntervalToggle" Margin="12,0,0,0" Checked="AutoClean_Changed" Unchecked="AutoClean_Changed" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="自动清理时包含冻结区" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Opacity="{DynamicResource DeemphasizedTextOpacity}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="勾选后自动清理也处理备用列表 / 已修改页面列表" />
                            </StackPanel>
                            <CheckBox x:Name="AllowFreezesToggle" Grid.Column="1" Margin="12,0,0,0" Checked="Policy_Changed" Unchecked="Policy_Changed" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="清理前确认" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Opacity="{DynamicResource DeemphasizedTextOpacity}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="手动清理前列出所选区域并请求确认" />
                            </StackPanel>
                            <CheckBox x:Name="ConfirmCleanToggle" Grid.Column="1" Margin="12,0,0,0" Checked="Policy_Changed" Unchecked="Policy_Changed" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="免 UAC 提权" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Opacity="{DynamicResource DeemphasizedTextOpacity}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="通过计划任务静默执行清理，不弹 UAC" />
                            </StackPanel>
                            <CheckBox x:Name="SkipUacToggle" Grid.Column="1" Margin="12,0,0,0" Click="SkipUac_Click" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
