<UserControl x:Class="ToolDock.App.Views.MemCleanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 对齐 Mem Reduct 主窗口：三组内存信息 + 清理按钮 + 区域勾选 + 自动清理 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,16,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="内存清理" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="SummaryText" Text="—" Style="{StaticResource PageSubtitleStyle}" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="CleanButton" Style="{StaticResource PrimaryButtonStyle}"
                    Click="CleanNow_Click" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource GlyphTextBlockStyle}" FontSize="14"
                               VerticalAlignment="Center" />
                    <TextBlock Text="立即清理" FontSize="14" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" FocusVisualStyle="{x:Null}">
            <StackPanel Margin="20,16,20,16">

                <!-- 三组内存信息（对齐 Mem Reduct 主窗口 ListView） -->
                <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 物理内存 -->
                        <Border Grid.Row="0" Padding="14,10" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="物理内存" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Height="5" CornerRadius="3" Background="{DynamicResource Nav.Checked}" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="PhysUsedCol" Width="0*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="3" Background="{DynamicResource Accent}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Column="1" x:Name="PhysUsedText" Text="—" FontSize="12" Margin="10,0,0,0"
                                               Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" x:Name="PhysPctText" Text="—" FontSize="18" FontWeight="Bold" MinWidth="52" TextAlignment="Right"
                                               Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </Grid>
                                <TextBlock x:Name="PhysSubText" Text="—" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- 系统工作集 -->
                        <Border Grid.Row="1" Padding="14,10" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="系统工作集" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Height="5" CornerRadius="3" Background="{DynamicResource Nav.Checked}" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="CacheUsedCol" Width="0*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="3" Background="{DynamicResource Accent}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Column="1" x:Name="CacheUsedText" Text="—" FontSize="12" Margin="10,0,0,0"
                                               Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" x:Name="CachePctText" Text="—" FontSize="18" FontWeight="Bold" MinWidth="52" TextAlignment="Right"
                                               Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </Grid>
                                <TextBlock x:Name="CacheSubText" Text="—" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- 页面文件 -->
                        <Border Grid.Row="2" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="页面文件" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Height="5" CornerRadius="3" Background="{DynamicResource Nav.Checked}" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="PfUsedCol" Width="0*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="3" Background="{DynamicResource Accent}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Column="1" x:Name="PfUsedText" Text="—" FontSize="12" Margin="10,0,0,0"
                                               Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" x:Name="PfPctText" Text="—" FontSize="18" FontWeight="Bold" MinWidth="52" TextAlignment="Right"
                                               Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </Grid>
                                <TextBlock x:Name="PfSubText" Text="—" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 清理区域 -->
                <TextBlock Text="清理区域" Style="{StaticResource SectionTitleStyle}" Margin="2,12,0,8" />
                <Border Style="{StaticResource SettingsCardStyle}" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <CheckBox x:Name="CbWorkingSet" Content="工作集" Margin="0,4" Checked="Region_Changed" Unchecked="Region_Changed" />
                            <CheckBox x:Name="CbSystemFileCache" Content="系统文件缓存" Margin="0,4" Checked="Region_Changed" Unchecked="Region_Changed" />
                            <CheckBox x:Name="CbModifiedList" Content="已修改页面列表 *" Margin="0,4" Checked="Region_Changed" Unchecked="Region_Changed" />
                            <CheckBox x:Name="CbStandbyList" Content="备用列表 *" Margin="0,4" Checked="Region_Changed" Unchecked="Region_Changed" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <CheckBox x:Name="CbStandbyPriority0" Content="备用列表（无优先级）" Margin="0,4" Checked="Region_Changed" Unchecked="Region_Changed" />
                            <CheckBox x:Name="CbModifiedFileCache" Content="已修改文件缓存" Margin="0,4" Checked="Region_Changed" Unchecked="Region_Changed" />
                            <CheckBox x:Name="CbRegistryCache" Content="注册表缓存" Margin="0,4" Checked="Region_Changed" Unchecked="Region_Changed" />
                            <CheckBox x:Name="CbCombineLists" Content="合并内存列表" Margin="0,4" Checked="Region_Changed" Unchecked="Region_Changed" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 自动清理 -->
                <TextBlock Text="自动清理" Style="{StaticResource SectionTitleStyle}" Margin="2,16,0,8" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="占用超过阈值时清理" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="阈值 %（50-99）" Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="ThresholdBox" Width="52" Height="30" TextAlignment="Center" Text="90" />
                                <ToggleButton x:Name="ThresholdToggle" Style="{StaticResource SwitchStyle}"
                                              Checked="AutoClean_Changed" Unchecked="AutoClean_Changed" Margin="12,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="定时清理" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="间隔分钟（5-720）" Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="IntervalBox" Width="52" Height="30" TextAlignment="Center" Text="30" />
                                <ToggleButton x:Name="IntervalToggle" Style="{StaticResource SwitchStyle}"
                                              Checked="AutoClean_Changed" Unchecked="AutoClean_Changed" Margin="12,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 免 UAC -->
                <TextBlock Text="免 UAC 提权" Style="{StaticResource SectionTitleStyle}" Margin="2,16,0,8" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid Margin="0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="通过计划任务静默提权" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="创建最高权限计划任务（ToolDock_Clean），清理不再弹 UAC"
                                       Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" x:Name="SkipUacToggle" Style="{StaticResource SwitchStyle}"
                                      Click="SkipUac_Click" VerticalAlignment="Center" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
