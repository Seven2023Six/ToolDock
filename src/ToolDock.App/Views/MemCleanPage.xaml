<UserControl x:Class="ToolDock.App.Views.MemCleanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 设计稿 ②：KPI + 内存构成条 + 清理区域勾选 + 自动清理策略 + 立即清理（真功能） -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,16,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="内存清理" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="SummaryText" Text="—" Style="{StaticResource PageSubtitleStyle}" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="CleanButton" Style="{StaticResource PrimaryButtonStyle}"
                    Click="CleanNow_Click" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource GlyphTextBlockStyle}" FontSize="14"
                               VerticalAlignment="Center" />
                    <TextBlock Text="立即清理" FontSize="14" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" FocusVisualStyle="{x:Null}">
            <StackPanel Margin="20,16,20,16" MaxWidth="860" HorizontalAlignment="Left">

                <!-- 总览卡：大百分比 + 内存构成条 -->
                <Border Style="{StaticResource CardStyle}" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="内存使用率" Style="{StaticResource CardLabelStyle}" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock x:Name="UsageText" Text="—" FontSize="30" FontWeight="Bold"
                                           Foreground="{DynamicResource Text.Primary}" />
                                <TextBlock Text="%" FontSize="14" FontWeight="SemiBold" Margin="2,10,0,0"
                                           Foreground="{DynamicResource Text.Primary}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Border Height="8" CornerRadius="4" Background="{DynamicResource Nav.Checked}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="UsedColumn" Width="0*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="4" Background="{DynamicResource Accent}" />
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock x:Name="UsedLegendText" Text="已用 —" FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}" Margin="0,0,16,0" />
                                <TextBlock x:Name="FreeLegendText" Text="可用 —" FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 清理区域（真功能：勾选即下发 Agent） -->
                <TextBlock Text="清理区域" Style="{StaticResource SectionTitleStyle}" Margin="2,16,0,8" />
                <Border Style="{StaticResource CardStyle}" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <CheckBox x:Name="CbWorkingSet" Content="工作集" Margin="0,4" Checked="Region_Changed" Unchecked="Region_Changed" />
                            <CheckBox x:Name="CbSystemFileCache" Content="系统文件缓存" Margin="0,4" Checked="Region_Changed" Unchecked="Region_Changed" />
                            <CheckBox x:Name="CbModifiedList" Content="已修改页面列表 *" Margin="0,4" Checked="Region_Changed" Unchecked="Region_Changed" />
                            <CheckBox x:Name="CbStandbyList" Content="备用列表 *" Margin="0,4" Checked="Region_Changed" Unchecked="Region_Changed" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <CheckBox x:Name="CbStandbyPriority0" Content="备用列表（无优先级）" Margin="0,4" Checked="Region_Changed" Unchecked="Region_Changed" />
                            <CheckBox x:Name="CbModifiedFileCache" Content="已修改文件缓存" Margin="0,4" Checked="Region_Changed" Unchecked="Region_Changed" />
                            <CheckBox x:Name="CbRegistryCache" Content="注册表缓存" Margin="0,4" Checked="Region_Changed" Unchecked="Region_Changed" />
                            <CheckBox x:Name="CbCombineLists" Content="合并内存列表" Margin="0,4" Checked="Region_Changed" Unchecked="Region_Changed" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 自动清理（真功能：策略经管道下发 Agent，关窗也生效） -->
                <TextBlock Text="自动清理" Style="{StaticResource SectionTitleStyle}" Margin="2,16,0,8" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="占用超过阈值时清理" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="阈值 %（50-99）" Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="ThresholdBox" Width="56" Height="30" TextAlignment="Center" Text="90" />
                                <ToggleButton x:Name="ThresholdToggle" Style="{StaticResource SwitchStyle}"
                                              Checked="AutoClean_Changed" Unchecked="AutoClean_Changed" Margin="12,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="定时清理" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="间隔分钟（5-720）" Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="IntervalBox" Width="56" Height="30" TextAlignment="Center" Text="30" />
                                <ToggleButton x:Name="IntervalToggle" Style="{StaticResource SwitchStyle}"
                                              Checked="AutoClean_Changed" Unchecked="AutoClean_Changed" Margin="12,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="CleanHintText" Margin="2,8,0,0" Style="{StaticResource CardFootnoteStyle}"
                           Text="清理经提权助手执行；开启「免 UAC」后自动清理与清理按钮将静默完成。" />

                <!-- 免 UAC -->
                <TextBlock Text="免 UAC 提权" Style="{StaticResource SectionTitleStyle}" Margin="2,16,0,8" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid Margin="0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="通过计划任务静默提权" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="创建最高权限计划任务（ToolDock_Clean），清理不再弹 UAC；区域变化时自动重建任务"
                                       Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" x:Name="SkipUacToggle" Style="{StaticResource SwitchStyle}"
                                      Click="SkipUac_Click" VerticalAlignment="Center" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
