<UserControl
    x:Class="ToolDock.App.Views.BatteryStatsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Foreground="{DynamicResource Text.Primary}">

    <!-- 统计子页：对应 VigilWatt 统计页——按设备 + 时间窗（24h / 7天 / 30天）看电量走势 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,4,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton GroupName="StatsRange" Content="24 小时" Tag="1" IsChecked="True"
                             Style="{StaticResource SubTabStyle}" Checked="Range_Checked" />
                <RadioButton GroupName="StatsRange" Content="7 天" Tag="7"
                             Style="{StaticResource SubTabStyle}" Checked="Range_Checked" />
                <RadioButton GroupName="StatsRange" Content="30 天" Tag="30"
                             Style="{StaticResource SubTabStyle}" Checked="Range_Checked" />
            </StackPanel>

            <ComboBox x:Name="DeviceBox" Grid.Column="1" MinWidth="220" MaxWidth="320"
                      Margin="12,0,0,0" VerticalAlignment="Center" Height="32"
                      SelectionChanged="Device_SelectionChanged" />

            <Button Grid.Column="2" MinWidth="92" Padding="12,6" Style="{StaticResource AppButtonStyle}"
                    Click="Refresh_Click" Content="刷新" />
        </Grid>

        <Border Grid.Row="1" Margin="20,10,20,0" Padding="16,12" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="SummaryText" FontSize="12"
                           Foreground="{DynamicResource Text.Secondary}" Text="—" />
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Canvas x:Name="ChartCanvas" ClipToBounds="True" SizeChanged="Chart_SizeChanged" />
                    <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="13" Foreground="{DynamicResource Text.Tertiary}"
                               Visibility="Collapsed"
                               Text="该时间范围内没有记录" />
                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Margin="20,8,20,12" FontSize="11"
                   Foreground="{DynamicResource Text.Tertiary}"
                   Text="曲线来自历史采样；采样间隔越短曲线越细。可在设置页调整采样间隔。" />
    </Grid>
</UserControl>
