<UserControl
    x:Class="ToolDock.App.Views.BatteryHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Foreground="{DynamicResource Text.Primary}">

    <!-- 历史子页：对应 VigilWatt 历史管理页——按设备汇总记录，可单删 / 清空 / 清理过期 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,0,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center"
                       Style="{StaticResource PageSubtitleStyle}" Text="读取中…" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button MinWidth="92" Padding="12,6" Style="{StaticResource AppButtonStyle}"
                        Click="Refresh_Click" Content="刷新" />
                <Button MinWidth="112" Margin="8,0,0,0" Padding="12,6" Style="{StaticResource AppButtonStyle}"
                        Click="Cleanup_Click" Content="清理过期记录" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="20,10,20,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="HistoryList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="16,12" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,4,0,0" FontSize="11"
                                               Foreground="{DynamicResource Text.Tertiary}"
                                               Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1" MinWidth="72" Margin="12,0,0,0" Padding="10,4"
                                        VerticalAlignment="Center" Style="{StaticResource AppButtonStyle}"
                                        Content="删除" Tag="{Binding DeviceId}" Click="DeleteOne_Click" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed">
            <TextBlock HorizontalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="40"
                       Foreground="{DynamicResource Text.Tertiary}" Text="&#xE81C;" />
            <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="15"
                       Foreground="{DynamicResource Text.Secondary}" Text="暂无历史记录" />
            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource Text.Tertiary}"
                       Text="设备电量变化并采样后会记录在这里" />
        </StackPanel>

        <TextBlock Grid.Row="2" Margin="20,8,20,12" FontSize="11"
                   Foreground="{DynamicResource Text.Tertiary}"
                   Text="删除记录只影响历史统计，不影响设备电量读取。" />
    </Grid>
</UserControl>
