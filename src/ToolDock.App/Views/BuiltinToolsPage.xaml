<UserControl
    x:Class="ToolDock.App.Views.BuiltinToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Foreground="{DynamicResource Text.Primary}">

    <!--
      内置工具页（第二栏）：图吧工具箱式的图标网格。
      单击工具图标 → 主界面切换为该工具的页面；工具页内「‹ 返回」回到本网格。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,20,24,0">
            <TextBlock Text="内置工具" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="工具坞自带的实用工具，单击图标打开" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- 图吧式提示条 -->
        <Border
            Grid.Row="1"
            Margin="24,16,24,0"
            Padding="16,10"
            CornerRadius="6"
            Background="{DynamicResource Card.Background}"
            BorderBrush="{DynamicResource Card.Stroke}"
            BorderThickness="1">
            <TextBlock
                Opacity="0.8"
                FontSize="13"
                Foreground="{DynamicResource Text.Secondary}"
                Text="提示：单击工具图标打开对应页面；是否启用该工具，在工具页面内部设置。" />
        </Border>

        <!-- 工具图标网格 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <WrapPanel Margin="20,12,20,24" Orientation="Horizontal">
                <!-- 内存清理 -->
                <Grid Margin="4">
                    <Button
                        x:Name="MemCleanCard"
                        AutomationProperties.Name="打开内存清理"
                        Click="MemClean_Click"
                        Style="{StaticResource ToolCardButtonStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <Image Width="40" Height="40" HorizontalAlignment="Center" Source="pack://application:,,,/mem_icon.png" />
                            <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="13" Text="内存清理" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                    <Border x:Name="MemCleanBadge" Margin="0,6,6,0" Padding="6,1" CornerRadius="4"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"
                            Background="{DynamicResource Nav.Checked}">
                        <TextBlock FontSize="10" Foreground="{DynamicResource Text.Secondary}" Text="已停用" />
                    </Border>
                </Grid>

                <!-- 外设电量显示 -->
                <Grid Margin="4">
                    <Button
                        x:Name="BatteryCard"
                        AutomationProperties.Name="打开外设电量显示"
                        Click="Battery_Click"
                        Style="{StaticResource ToolCardButtonStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <Image Width="40" Height="40" HorizontalAlignment="Center" Source="pack://application:,,,/battery_icon.png" />
                            <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="13" Text="外设电量显示" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                    <Border x:Name="BatteryBadge" Margin="0,6,6,0" Padding="6,1" CornerRadius="4"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"
                            Background="{DynamicResource Nav.Checked}">
                        <TextBlock FontSize="10" Foreground="{DynamicResource Text.Secondary}" Text="已停用" />
                    </Border>
                </Grid>

                <!-- 输入法状态提示（内置 InputTip 引擎） -->
                <Grid Margin="4">
                    <Button
                        x:Name="InputTipCard"
                        AutomationProperties.Name="打开输入法状态提示"
                        Click="InputTip_Click"
                        Style="{StaticResource ToolCardButtonStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <Image Width="40" Height="40" HorizontalAlignment="Center" Source="pack://application:,,,/inputtip_icon.png" />
                            <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="13" Text="输入法状态提示" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                    <Border x:Name="InputTipBadge" Margin="0,6,6,0" Padding="6,1" CornerRadius="4"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"
                            Background="{DynamicResource Nav.Checked}">
                        <TextBlock FontSize="10" Foreground="{DynamicResource Text.Secondary}" Text="已停用" />
                    </Border>
                </Grid>

                <!-- 窗口拖拽（内置 AltSnap 内核） -->
                <Grid Margin="4">
                    <Button
                        x:Name="AltSnapCard"
                        AutomationProperties.Name="打开窗口拖拽"
                        Click="AltSnap_Click"
                        Style="{StaticResource ToolCardButtonStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <Image Width="40" Height="40" HorizontalAlignment="Center" Source="pack://application:,,,/altsnap_icon.png" />
                            <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="13" Text="窗口拖拽" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                    <Border x:Name="AltSnapBadge" Margin="0,6,6,0" Padding="6,1" CornerRadius="4"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"
                            Background="{DynamicResource Nav.Checked}">
                        <TextBlock FontSize="10" Foreground="{DynamicResource Text.Secondary}" Text="已停用" />
                    </Border>
                </Grid>

                <!-- MAS 激活工具（内置官方脚本，点击卡片打开页面） -->
                <Grid Margin="4">
                    <Button
                        x:Name="MasCard"
                        AutomationProperties.Name="打开MAS激活工具"
                        Click="Mas_Click"
                        Style="{StaticResource ToolCardButtonStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <Image Width="40" Height="40" HorizontalAlignment="Center" Source="pack://application:,,,/mas_icon.png" />
                            <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="13" Text="MAS 激活工具" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </Grid>
            </WrapPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
