<UserControl x:Class="ToolDock.App.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,16,20,8">
            <TextBlock Text="关于" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="版本、许可与第三方组件" Style="{StaticResource PageSubtitleStyle}" Margin="0,2,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" FocusVisualStyle="{x:Null}">
            <StackPanel Margin="20,8,20,16">

                <Border Style="{StaticResource CardStyle}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="工具坞 ToolDock" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Primary}" />
                        <TextBlock x:Name="VersionText" FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}" Margin="0,2,0,0" />
                        <TextBlock Text="只保留一个托盘图标，把所有小工具收拢进同一座坞；可以持续往里加工具的载体。"
                                   FontSize="13" Foreground="{DynamicResource Text.Secondary}"
                                   Margin="0,10,0,0" TextWrapping="Wrap" />

                        <Button x:Name="OpenLogsButton" Content="打开日志目录"
                                Style="{StaticResource AppButtonStyle}"
                                HorizontalAlignment="Left" Margin="0,12,0,0"
                                AutomationProperties.Name="打开日志目录"
                                Click="OpenLogs_Click" />

                        <Border Style="{StaticResource RowDividerStyle}" Margin="0,12" />

                        <TextBlock Text="第三方组件与设计参考" Style="{StaticResource CardLabelStyle}" />
                        <TextBlock Text="VigilWatt（MIT）— 窗口结构、视觉语言与电量数据层&#x0a;AltSnap 1.68（GPL-3.0）— 窗口拖拽引擎内核（内置版本 1.0）&#x0a;InputTip 3.6.12（AGPL-3.0）— 输入法状态提示行为参照（原生 C# 重写）&#x0a;Mem Reduct（GPL-3.0）— 内存清理参照&#x0a;Microsoft Activation Scripts 3.12 — 内置 MAS 激活脚本&#x0a;Uninstall Tool 3.8.2 — 内置实用工具&#x0a;PowerToys — 自启动行为参照"
                                   FontSize="12" Foreground="{DynamicResource Text.Secondary}"
                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
