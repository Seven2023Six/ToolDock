<UserControl x:Class="ToolDock.App.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 首页 · 方案四「Widget 墙」：每个格子是一个迷你工具，可操作的直接操作。
         仪表盘属性：不限宽、大字号、大留白，随窗口拉伸。 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" FocusVisualStyle="{x:Null}">
        <Grid Margin="20,16,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 内存 Widget（左，纵跨两行）：看一眼 + 直接清理 -->
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                    Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="内存使用率" Style="{StaticResource CardLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock x:Name="MemUsageText" Text="—" FontSize="46" FontWeight="Bold"
                                   Foreground="{DynamicResource Text.Primary}" />
                        <TextBlock Text="%" FontSize="18" FontWeight="SemiBold" Margin="4,16,0,0"
                                   Foreground="{DynamicResource Text.Primary}" />
                    </StackPanel>
                    <Border Height="8" CornerRadius="4" Background="{DynamicResource Nav.Checked}" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="MemUsedColumn" Width="0*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="4" Background="{DynamicResource Accent}" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="MemFootnoteText" Text="已用 — / — GB"
                               Foreground="{DynamicResource Text.Secondary}" Margin="0,8,0,0" />
                    <Button Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False"
                            HorizontalAlignment="Left" Margin="0,16,0,0" 
                            ToolTip="等待内存清理插件与提权方案定案（里程碑 M2）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource GlyphTextBlockStyle}" FontSize="14"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="立即清理" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 时钟 Widget -->
            <Border Grid.Row="0" Grid.Column="1"
                    Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="ClockText" Text="—:—" FontSize="42" FontWeight="Bold"
                               Foreground="{DynamicResource Text.Primary}" />
                    <TextBlock x:Name="DateText" Text="—" FontSize="13"
                               Foreground="{DynamicResource Text.Secondary}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- 设备电量 Widget（M1 接入真数据） -->
            <Border Grid.Row="1" Grid.Column="1"
                    Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,12" >
                <StackPanel>
                    <TextBlock Text="设备电量" Style="{StaticResource CardLabelStyle}" />
                    <TextBlock Text="—" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Secondary}" Margin="0,6,0,0" />
                    <TextBlock Text="电量插件未接入 · 里程碑 M1 显示外设电量与低电量提醒"
                               Style="{StaticResource CardFootnoteStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 快捷开关 Widget（横跨两列；M3 接入真实逻辑） -->
            <Border Grid.Row="2" Grid.ColumnSpan="2"
                    Style="{StaticResource CardStyle}" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="快捷开关" Style="{StaticResource CardLabelStyle}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0" Margin="0,0,14,0">
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}"
                                          IsChecked="False" IsEnabled="False" VerticalAlignment="Center"
                                          ToolTip="里程碑 M3 接入" />
                            <TextBlock Text="开机自启"
                                       Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Grid.Column="1" Margin="0,0,14,0">
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}"
                                          IsChecked="False" IsEnabled="False" VerticalAlignment="Center"
                                          ToolTip="里程碑 M3 接入" />
                            <TextBlock Text="静默启动"
                                       Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Grid.Column="2">
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}"
                                          IsChecked="True" IsEnabled="False" VerticalAlignment="Center"
                                          ToolTip="随电量插件接入（里程碑 M1）" />
                            <TextBlock Text="低电量提醒"
                                       Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
