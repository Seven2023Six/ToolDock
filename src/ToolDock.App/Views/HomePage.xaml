<UserControl
    x:Class="ToolDock.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ToolDock.App.Controls"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- 首页：Gallery 卡片语言（标题区 + 卡片网格） -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader
            Grid.Row="0"
            Margin="0,0,0,24"
            Title="首页"
            Description="内存状态与常用开关的集中入口" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 内存卡片 -->
            <Border
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,12,12"
                Padding="24"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource OverlayCornerRadius}">
                <StackPanel>
                    <TextBlock Text="物理内存占用" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        x:Name="UsageText"
                        Margin="0,8,0,0"
                        FontSize="40"
                        FontWeight="SemiBold"
                        Text="--" />
                    <ProgressBar
                        x:Name="UsageBar"
                        Height="8"
                        Margin="0,12,0,0"
                        Maximum="100" />
                    <TextBlock
                        x:Name="MemFootnoteText"
                        Margin="0,8,0,0"
                        Opacity="{DynamicResource DeemphasizedTextOpacity}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="读取中…" />
                    <Button
                        x:Name="CleanButton"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Left"
                        Click="CleanNow_Click"
                        Content="立即清理" />
                </StackPanel>
            </Border>

            <!-- 时间卡片 -->
            <Border
                Grid.Row="0"
                Grid.Column="1"
                Margin="12,0,0,12"
                Padding="24"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource OverlayCornerRadius}">
                <StackPanel>
                    <TextBlock Text="当前时间" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        x:Name="ClockText"
                        Margin="0,8,0,0"
                        FontSize="40"
                        FontWeight="SemiBold"
                        Text="--:--" />
                    <TextBlock
                        x:Name="DateText"
                        Margin="0,8,0,0"
                        Opacity="{DynamicResource DeemphasizedTextOpacity}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Border>

            <!-- 快捷开关卡片 -->
            <Border
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,0,12,12"
                Padding="24"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource OverlayCornerRadius}">
                <StackPanel>
                    <TextBlock Text="快捷开关" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <CheckBox
                        x:Name="AutoCleanToggle"
                        Margin="0,12,0,0"
                        Checked="AutoClean_Changed"
                        Content="自动清理内存"
                        Unchecked="AutoClean_Changed" />
                    <CheckBox
                        x:Name="SkipUacToggle"
                        Margin="0,8,0,0"
                        Checked="SkipUac_Changed"
                        Content="免 UAC 提权清理"
                        Unchecked="SkipUac_Changed" />
                    <CheckBox
                        x:Name="AutoStartToggle"
                        Margin="0,8,0,0"
                        Checked="AutoStart_Changed"
                        Content="开机自动运行工具坞"
                        Unchecked="AutoStart_Changed" />
                </StackPanel>
            </Border>

            <!-- 状态卡片 -->
            <Border
                Grid.Row="1"
                Grid.Column="1"
                Margin="12,0,0,12"
                Padding="24"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource OverlayCornerRadius}">
                <StackPanel>
                    <TextBlock Text="运行状态" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        x:Name="AgentStatusText"
                        Margin="0,12,0,0"
                        Opacity="{DynamicResource DeemphasizedTextOpacity}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        TextWrapping="Wrap"
                        Text="读取中…" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
