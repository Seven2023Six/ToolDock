<UserControl x:Class="ToolDock.App.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 首页 · 方案四「Widget 墙」：每个格子是一个迷你工具，可操作的直接操作。
         仪表盘属性：不限宽、大字号、大留白，随窗口拉伸。 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" FocusVisualStyle="{x:Null}">
        <!-- 两张卡片：宽度平铺等分，高度弹性收缩到内容（同行等高） -->
        <Grid Margin="20,16,20,16" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 内存 Widget（左）：看一眼 + 直接清理 -->
            <Border Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="内存使用率" Style="{StaticResource CardLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock x:Name="MemUsageText" Text="—" FontSize="46" FontWeight="Bold"
                                   Foreground="{DynamicResource Text.Primary}" />
                        <TextBlock Text="%" FontSize="18" FontWeight="SemiBold" Margin="4,16,0,0"
                                   Foreground="{DynamicResource Text.Primary}" />
                    </StackPanel>
                    <Border Height="8" CornerRadius="4" Background="{DynamicResource Nav.Checked}" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="MemUsedColumn" Width="0*" />
                                <ColumnDefinition x:Name="MemFreeColumn" Width="100*" />
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="4" Background="{DynamicResource Accent}" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="MemFootnoteText" Text="已用 — / — GB"
                               Foreground="{DynamicResource Text.Secondary}" Margin="0,8,0,0" />
                    <Button x:Name="CleanButton" Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left" Margin="0,16,0,0"
                            Click="CleanNow_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource GlyphTextBlockStyle}" FontSize="14"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="立即清理" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 设备电量 Widget：最低电量做主数字，其余设备一行一台；整卡点击进入电量页 -->
            <Border x:Name="BatteryCard" Grid.Row="0" Grid.Column="1"
                    Style="{StaticResource CardStyle}" Padding="16,14"
                    Cursor="Hand" MouseLeftButtonUp="BatteryCard_Click"
                    ToolTip="打开外设电量显示">
                <StackPanel>
                    <TextBlock Text="设备电量" Style="{StaticResource CardLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock x:Name="BatteryLowText" Text="—" FontSize="46" FontWeight="Bold"
                                   Foreground="{DynamicResource Text.Primary}" />
                        <TextBlock x:Name="BatteryLowSuffix" Text="%" FontSize="18" FontWeight="SemiBold"
                                   Margin="4,16,0,0" Foreground="{DynamicResource Text.Primary}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                    <TextBlock x:Name="BatteryLowName" Text="暂无在线设备"
                               Foreground="{DynamicResource Text.Secondary}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <ItemsControl x:Name="BatteryDeviceList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource GlyphTextBlockStyle}"
                                               FontSize="13" Foreground="{DynamicResource Text.Secondary}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0,8,0"
                                               FontSize="12" Foreground="{DynamicResource Text.Secondary}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding PercentText}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding Brush}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="BatteryHint" Text="查看详情 ›"
                               Style="{StaticResource CardFootnoteStyle}" Margin="0,10,0,0"
                               Foreground="{DynamicResource Accent}" Visibility="Collapsed" />
                </StackPanel>
            </Border>


        </Grid>
    </ScrollViewer>
</UserControl>
