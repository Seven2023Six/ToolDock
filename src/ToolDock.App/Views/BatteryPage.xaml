<UserControl
    x:Class="ToolDock.App.Views.BatteryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Foreground="{DynamicResource Text.Primary}">

    <!--
      外设电量显示：设计沿用 VigilWatt 的设备列表页——
      标题/副标题 + 右上刷新；每台设备一张卡：类型图标 · 名称+来源徽标+充电闪电 · 电量条 · 细节行 · 大号百分比。
    -->
    <UserControl.Resources>
        <!-- 圆角细电量条（6px） -->
        <Style x:Key="BatteryBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="3" Background="{TemplateBinding Background}" />
                            <Border x:Name="PART_Track" />
                            <Border
                                x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                CornerRadius="3"
                                Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 + 副标题 + 右上刷新（与内存清理页同款头部） -->
        <Grid Grid.Row="0" Margin="20,16,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button
                        Click="Back_Click"
                        Content="‹ 返回"
                        Cursor="Hand"
                        Focusable="False"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6,2"
                        FontSize="13"
                        Foreground="{DynamicResource Text.Secondary}" />
                    <TextBlock Text="外设电量显示" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock
                    x:Name="SummaryText"
                    Margin="0,2,0,0"
                    Style="{StaticResource PageSubtitleStyle}"
                    Text="正在扫描设备…" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
            <CheckBox
                x:Name="SystemBatteryToggle"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                Content="本机电量"
                Checked="SystemBattery_Changed"
                Unchecked="SystemBattery_Changed" />
            <Button
                x:Name="RefreshButton"
                MinWidth="92"
                Padding="12,6"
                Style="{StaticResource AppButtonStyle}"
                Click="Refresh_Click"
                VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        x:Name="RefreshIcon"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="13"
                        Text="&#xE72C;" />
                    <TextBlock
                        x:Name="RefreshText"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Text="刷新" />
                </StackPanel>
            </Button>
            </StackPanel>
        </Grid>

        <!-- 设备列表 -->
        <ScrollViewer Grid.Row="1" Margin="20,12,20,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="DeviceList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="16,12" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 类型图标 -->
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="20"
                                    Foreground="{DynamicResource Text.Primary}"
                                    Text="{Binding IconGlyph}" />

                                <!-- 名称 / 来源徽标 / 充电标记 + 电量条 + 细节 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <Border
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Padding="6,2"
                                            VerticalAlignment="Center"
                                            Background="{Binding SourceBackgroundBrush}"
                                            CornerRadius="4">
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Foreground="{Binding SourceBrush}"
                                                Text="{Binding SourceText}" />
                                        </Border>
                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="{Binding ProgressBrush}"
                                            Text="⚡"
                                            Visibility="{Binding ChargingVisibility}" />
                                    </Grid>
                                    <ProgressBar
                                        Margin="0,8,0,0"
                                        Background="{DynamicResource Nav.Checked}"
                                        Foreground="{Binding ProgressBrush}"
                                        Style="{StaticResource BatteryBarStyle}"
                                        Value="{Binding Progress}" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource Text.Tertiary}"
                                        Text="{Binding SubText}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- 大号百分比 -->
                                <TextBlock
                                    Grid.Column="2"
                                    MinWidth="78"
                                    Margin="14,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="26"
                                    FontWeight="Bold"
                                    Foreground="{Binding PercentBrush}"
                                    Text="{Binding PercentText}"
                                    TextAlignment="Right" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 空态（未发现设备） -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed">
            <TextBlock
                HorizontalAlignment="Center"
                FontFamily="Segoe MDL2 Assets"
                FontSize="40"
                Foreground="{DynamicResource Text.Tertiary}"
                Text="&#xE702;" />
            <TextBlock
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                FontSize="15"
                Foreground="{DynamicResource Text.Secondary}"
                Text="未发现设备" />
            <TextBlock
                x:Name="EmptyHint"
                Margin="0,6,0,0"
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource Text.Tertiary}"
                Text="连接蓝牙设备或插入 2.4G 接收器，然后点击刷新" />
        </StackPanel>

        <!-- 底部说明 -->
        <TextBlock
            x:Name="FootNote"
            Grid.Row="2"
            Margin="20,8,20,12"
            FontSize="11"
            Foreground="{DynamicResource Text.Tertiary}"
            Text="数据来自蓝牙电量服务与已适配的 2.4G 设备协议。" />
    </Grid>
</UserControl>
