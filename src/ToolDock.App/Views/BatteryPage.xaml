<UserControl
    x:Class="ToolDock.App.Views.BatteryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Foreground="{DynamicResource Text.Primary}">

    <!--
      外设电量显示：VigilWatt 功能的 ToolDock 版外壳。
      子页：设备 / 统计 / 历史 / 设置（VigilWatt 的四个主页面）。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,16,20,0">
            <StackPanel Orientation="Horizontal">
                <Button
                    Click="Back_Click"
                    Content="‹ 返回"
                    Cursor="Hand"
                    Focusable="False"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="6,2"
                    FontSize="13"
                    Foreground="{DynamicResource Text.Secondary}" />
                <TextBlock Text="外设电量显示" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <!-- 子页切换 -->
        <StackPanel Grid.Row="1" Margin="20,12,20,0" Orientation="Horizontal">
            <RadioButton GroupName="BatteryTab" Content="设备" Tag="devices" IsChecked="True"
                         Style="{StaticResource SubTabStyle}" Checked="Tab_Checked" />
            <RadioButton GroupName="BatteryTab" Content="统计" Tag="stats"
                         Style="{StaticResource SubTabStyle}" Checked="Tab_Checked" />
            <RadioButton GroupName="BatteryTab" Content="历史" Tag="history"
                         Style="{StaticResource SubTabStyle}" Checked="Tab_Checked" />
            <RadioButton GroupName="BatteryTab" Content="诊断" Tag="capture"
                         Style="{StaticResource SubTabStyle}" Checked="Tab_Checked" />
            <RadioButton GroupName="BatteryTab" Content="电量设置" Tag="settings"
                         Style="{StaticResource SubTabStyle}" Checked="Tab_Checked" />
        </StackPanel>

        <ContentControl x:Name="TabHost" Grid.Row="2" Margin="0,8,0,0" />
    </Grid>
</UserControl>
