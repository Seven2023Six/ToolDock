<UserControl x:Class="ToolDock.App.Views.MasPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,16,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button Click="Back_Click" Cursor="Hand" Focusable="False"
                            Background="Transparent" BorderThickness="0" Padding="6,2"
                            Content="‹ 返回" FontSize="13"
                            Foreground="{DynamicResource Text.Secondary}" />
                    <TextBlock Text="MAS 激活工具" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="SummaryText" Text="—" Style="{StaticResource PageSubtitleStyle}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="LaunchButton" Style="{StaticResource PrimaryButtonStyle}"
                        Click="Launch_Click"
                        AutomationProperties.Name="打开激活菜单"
                        ToolTip="弹出 MAS 原版控制台菜单（请求一次管理员授权）">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource GlyphTextBlockStyle}" FontSize="14"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="打开激活菜单" FontSize="14" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" x:Name="ToolContent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" FocusVisualStyle="{x:Null}">
            <StackPanel Margin="20,16,20,16">

                <!-- 脚本状态与更新 -->
                <TextBlock Text="脚本" Style="{StaticResource SectionTitleStyle}" Margin="2,4,0,8" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="ScriptVersionText" Text="—" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock x:Name="ScriptStatusText" Text="—" Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button x:Name="UpdateButton" Grid.Column="1" Style="{StaticResource AppButtonStyle}"
                                    Click="Update_Click" VerticalAlignment="Center"
                                    AutomationProperties.Name="检查更新"
                                    ToolTip="从官方源 get.activated.win 拉取最新脚本并校验哈希">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource GlyphTextBlockStyle}" FontSize="14"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="UpdateButtonText" Text="检查更新" FontSize="14" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="脚本来源" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="Microsoft Activation Scripts（massgrave.dev），随工具箱内置分发，离线可用"
                                           Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 菜单功能 -->
                <TextBlock Text="激活菜单包含" Style="{StaticResource SectionTitleStyle}" Margin="2,16,0,8" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="HWID" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="数字许可证永久激活 Windows 10/11（需联网）" Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Ohook" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="永久激活 Office（Retail/Volume）" Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="TSforge" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="数字权利激活 Windows / Office（永久 / 大周期）" Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="KMS38 / 在线 KMS" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="KMS38 激活到 2038 年；在线 KMS 180 天周期自动续期" Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="激活疑难解答" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="修复激活状态、重装许可证、清理残留 KMS 等实用脚本" Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 说明 -->
                <TextBlock Text="说明" Style="{StaticResource SectionTitleStyle}" Margin="2,16,0,8" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Margin="0,10">
                        <TextBlock Style="{StaticResource RowDescStyle}" TextWrapping="Wrap"
                                   Text="• 主菜单界面已汉化（仅界面文案，激活逻辑与官方脚本完全一致）；「检查更新」拉取官方新版后，启动时会自动重新套用汉化。" Margin="0,4" />
                        <TextBlock Style="{StaticResource RowDescStyle}" TextWrapping="Wrap"
                                   Text="• 首次打开请求一次管理员授权（UAC），之后本次会话内不再重复；与官方 irm https://get.activated.win | iex 行为一致。" Margin="0,4" />
                        <TextBlock Style="{StaticResource RowDescStyle}" TextWrapping="Wrap"
                                   Text="• 内置脚本已按官方发布清单校验 SHA-256；「检查更新」从官方源拉取最新版并重新校验。" Margin="0,4" />
                        <TextBlock Style="{StaticResource RowDescStyle}" TextWrapping="Wrap"
                                   Text="• 部分杀毒软件会把激活脚本误报为风险程序（官方仓库多次被误报）；如被拦截，请将 ToolDock 加入信任区后重试。" Margin="0,4" />
                        <TextBlock Style="{StaticResource RowDescStyle}" TextWrapping="Wrap"
                                   Text="• 官方主页：massgrave.dev（GitHub：massgravel/Microsoft-Activation-Scripts）" Margin="0,4" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
