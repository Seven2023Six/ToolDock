<UserControl x:Class="ToolDock.App.Views.AltSnapPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="20,16,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button Click="Back_Click" Cursor="Hand" Focusable="False"
                            Background="Transparent" BorderThickness="0" Padding="6,2"
                            Content="‹ 返回" FontSize="13"
                            Foreground="{DynamicResource Text.Secondary}" />
                    <TextBlock Text="AltSnap" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Alt + 拖动窗口：移动 / 缩放 / 贴边吸附"
                           Style="{StaticResource PageSubtitleStyle}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock x:Name="StatusText" Text="检查中…" FontSize="13"
                           Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Margin="0,4,0,0">
            <StackPanel Margin="20,8,20,24">

                <!-- 工具开关 -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="启用 AltSnap" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="停用后退出 AltSnap；重新启用会再次拉起（跟随工具箱启动）"
                                           Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="ToolEnabledToggle" Grid.Column="1"
                                          Style="{StaticResource SwitchStyle}" Click="ToolEnabled_Changed"
                                          VerticalAlignment="Center" />
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="程序版本" Style="{StaticResource RowTitleStyle}" VerticalAlignment="Center" />
                            <TextBlock x:Name="VersionText" Grid.Column="1" Text="—" FontSize="13"
                                       Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="ToolContent">
                    <!-- 操作 -->
                    <TextBlock Text="鼠标操作" Style="{StaticResource SectionTitleStyle}" Margin="2,18,0,8" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Alt + 左键" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="按住 Alt 在窗口任意位置拖动即可移动" Style="{StaticResource RowDescStyle}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <ComboBox x:Name="LmbBox" Grid.Column="1" Width="180" Height="32"
                                          VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="移动窗口" Tag="Move" />
                                    <ComboBoxItem Content="无动作" Tag="Nothing" />
                                </ComboBox>
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />
                            <Grid Margin="0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Alt + 右键" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="从窗口边缘拖动改变大小" Style="{StaticResource RowDescStyle}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <ComboBox x:Name="RmbBox" Grid.Column="1" Width="180" Height="32"
                                          VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="缩放窗口" Tag="Resize" />
                                    <ComboBoxItem Content="移动窗口" Tag="Move" />
                                    <ComboBoxItem Content="无动作" Tag="Nothing" />
                                </ComboBox>
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />
                            <Grid Margin="0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Alt + 中键" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="弹出窗口菜单，或按需改为最小化/置底" Style="{StaticResource RowDescStyle}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <ComboBox x:Name="MmbBox" Grid.Column="1" Width="180" Height="32"
                                          VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="窗口菜单" Tag="Menu" />
                                    <ComboBoxItem Content="最小化" Tag="Minimize" />
                                    <ComboBoxItem Content="置于底层" Tag="Lower" />
                                    <ComboBoxItem Content="无动作" Tag="Nothing" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 行为 -->
                    <TextBlock Text="行为" Style="{StaticResource SectionTitleStyle}" Margin="2,18,0,8" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="贴边吸附（Aero）" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="拖到屏幕边缘或角落自动分屏/最大化" Style="{StaticResource RowDescStyle}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="AeroToggle" Grid.Column="1" Style="{StaticResource SwitchStyle}"
                                              VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />
                            <Grid Margin="0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="智能吸附" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="调整已贴边窗口时，联动相邻窗口尺寸" Style="{StaticResource RowDescStyle}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="SmartAeroToggle" Grid.Column="1" Style="{StaticResource SwitchStyle}"
                                              VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />
                            <Grid Margin="0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="拖动时自动置前" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="拖动哪个窗口就把它提到最前并聚焦" Style="{StaticResource RowDescStyle}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="AutoFocusToggle" Grid.Column="1" Style="{StaticResource SwitchStyle}"
                                              VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />
                            <Grid Margin="0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="拖动时半透明" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="拖动/缩放时把窗口调到约 78% 不透明度" Style="{StaticResource RowDescStyle}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="TransToggle" Grid.Column="1" Style="{StaticResource SwitchStyle}"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 排除进程 -->
                    <TextBlock Text="排除进程" Style="{StaticResource SectionTitleStyle}" Margin="2,18,0,8" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Margin="0,12">
                            <TextBlock Text="AltSnap 不接管这些程序（英文逗号分隔，可留空）"
                                       Style="{StaticResource RowDescStyle}" Margin="0,0,0,8" />
                            <TextBox x:Name="PauseBox" Height="86" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Style="{StaticResource WinUITextBoxStyle}"
                                     FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 底部操作 -->
                <StackPanel Orientation="Horizontal" Margin="2,18,0,0">
                    <Button x:Name="SaveButton" Content="保存并重启 AltSnap" Style="{StaticResource PrimaryButtonStyle}"
                            Click="Save_Click" />
                    <Button Content="恢复默认" Style="{StaticResource AppButtonStyle}" Margin="8,0,0,0"
                            Click="Reset_Click" />
                    <Button Content="打开配置文件" Style="{StaticResource AppButtonStyle}" Margin="8,0,0,0"
                            Click="OpenConfig_Click" />
                    <TextBlock x:Name="SaveStatus" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource Text.Secondary}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
