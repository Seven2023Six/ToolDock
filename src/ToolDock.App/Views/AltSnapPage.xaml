<UserControl x:Class="ToolDock.App.Views.AltSnapPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="20,16,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button Click="Back_Click" Cursor="Hand" Focusable="False"
                            Background="Transparent" BorderThickness="0" Padding="6,2"
                            Content="‹ 返回" FontSize="13"
                            Foreground="{DynamicResource Text.Secondary}" />
                    <TextBlock Text="窗口拖拽" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="内置窗口拖拽引擎 1.0 · 按原版分类配置 · 无独立进程与托盘"
                           Style="{StaticResource PageSubtitleStyle}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock x:Name="StatusText" Text="检查中…" FontSize="13"
                           Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 引擎开关 -->
        <Border Grid.Row="1" Margin="20,10,20,0" Style="{StaticResource SettingsCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,12" VerticalAlignment="Center">
                    <TextBlock Text="启用窗口拖拽" Style="{StaticResource RowTitleStyle}" />
                    <TextBlock Text="引擎随工具箱后台运行；关闭后立即卸载鼠标钩子，配置保留"
                               Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="IniPathText" Text="—" FontSize="11" Margin="0,6,0,0"
                               Foreground="{DynamicResource Text.Secondary}"
                               TextTrimming="CharacterEllipsis" MaxWidth="760" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,12" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="引擎 " FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Secondary}" />
                    <TextBlock x:Name="VersionText" Text="1.0" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Secondary}" />
                    <ToggleButton x:Name="ToolEnabledToggle" Margin="14,0,0,0"
                                  Style="{StaticResource SwitchStyle}" Click="ToolEnabled_Changed"
                                  VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 原版分类：常规 / 鼠标 / 键盘 / 黑名单 / 高级 -->
        <Grid x:Name="EditorArea" Grid.Row="2" Margin="20,12,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                <RadioButton Content="常规" Tag="General" GroupName="AltSnapTab"
                             Style="{StaticResource SubTabStyle}" IsChecked="True" Checked="Tab_Checked" />
                <RadioButton Content="鼠标" Tag="Mouse" GroupName="AltSnapTab"
                             Style="{StaticResource SubTabStyle}" Checked="Tab_Checked" />
                <RadioButton Content="键盘" Tag="Keyboard" GroupName="AltSnapTab"
                             Style="{StaticResource SubTabStyle}" Checked="Tab_Checked" />
                <RadioButton Content="黑名单" Tag="Blacklist" GroupName="AltSnapTab"
                             Style="{StaticResource SubTabStyle}" Checked="Tab_Checked" />
                <RadioButton Content="高级" Tag="Advanced" GroupName="AltSnapTab"
                             Style="{StaticResource SubTabStyle}" Checked="Tab_Checked" />
            </StackPanel>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="GeneralPane" Focusable="False" FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="0,4,4,8">
                    <StackPanel x:Name="GeneralHost" />
                </ScrollViewer>
                <ScrollViewer x:Name="MousePane" Focusable="False" FocusVisualStyle="{x:Null}" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="0,4,4,8">
                    <StackPanel x:Name="MouseHost" />
                </ScrollViewer>
                <ScrollViewer x:Name="KeyboardPane" Focusable="False" FocusVisualStyle="{x:Null}" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="0,4,4,8">
                    <StackPanel x:Name="KeyboardHost" />
                </ScrollViewer>
                <ScrollViewer x:Name="BlacklistPane" Focusable="False" FocusVisualStyle="{x:Null}" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="0,4,4,8">
                    <StackPanel x:Name="BlacklistHost" />
                </ScrollViewer>
                <ScrollViewer x:Name="AdvancedPane" Focusable="False" FocusVisualStyle="{x:Null}" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="0,4,4,8">
                    <StackPanel x:Name="AdvancedHost" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 底部操作 -->
        <Grid Grid.Row="3" Margin="20,10,20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="SaveButton" Content="应用并重启引擎" Style="{StaticResource PrimaryButtonStyle}"
                        Click="Save_Click" />
                <Button Content="恢复默认配置" Style="{StaticResource AppButtonStyle}" Margin="8,0,0,0"
                        Click="Reset_Click" />
                <Button Content="打开配置文件" Style="{StaticResource AppButtonStyle}" Margin="8,0,0,0"
                        Click="OpenConfig_Click" />
            </StackPanel>
            <TextBlock x:Name="SaveStatus" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"
                       FontSize="13" Foreground="{DynamicResource Text.Secondary}" />
        </Grid>
    </Grid>
</UserControl>
