<UserControl
    x:Class="ToolDock.App.Views.CustomToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Foreground="{DynamicResource Text.Primary}">

    <!--
      自定义工具页：图吧工具箱式的分类工具网格（图标 + 名称，单击选中查看说明，双击启动）。
      工具清单由后续版本注入；当前为空态。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,20,24,0">
            <TextBlock Text="自定义" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="你的专属工具分类" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- 图吧式提示条 -->
        <Border
            Grid.Row="1"
            Margin="24,16,24,0"
            Padding="16,10"
            CornerRadius="6"
            Background="{DynamicResource Card.Background}"
            BorderBrush="{DynamicResource Card.Stroke}"
            BorderThickness="1">
            <TextBlock
                Opacity="0.8"
                FontSize="13"
                Foreground="{DynamicResource Text.Secondary}"
                Text="提示：该分类用于收纳你自定义的工具，双击图标即可启动。" />
        </Border>

        <!-- 工具网格：ItemsSource 绑定工具集合，当前空态 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,16,24,24">
                <ItemsControl x:Name="ToolsList" Visibility="Collapsed" />

                <!-- 空态 -->
                <Border
                    Padding="40,32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="8"
                    Background="{DynamicResource Card.Background}"
                    BorderBrush="{DynamicResource Card.Stroke}"
                    BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="44"
                            Foreground="{DynamicResource Text.Tertiary}"
                            Text="&#xE71D;" />
                        <TextBlock
                            Margin="0,14,0,0"
                            HorizontalAlignment="Center"
                            FontSize="14"
                            Foreground="{DynamicResource Text.Primary}"
                            Text="该分类暂无工具" />
                        <TextBlock
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource Text.Tertiary}"
                            Text="后续版本将在此收纳你的自定义工具" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
