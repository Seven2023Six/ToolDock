<UserControl x:Class="ToolDock.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 结构对齐 VigilWatt 设置页：页头固定 + ScrollViewer 内容 + 分节/行语言；内容通栏铺满 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,16,20,8">
            <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="外观、托盘与启动、日志" Style="{StaticResource PageSubtitleStyle}" Margin="0,2,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" FocusVisualStyle="{x:Null}">
            <StackPanel Margin="20,8,20,16">

                <!-- 外观 -->
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="外观" Style="{StaticResource SectionTitleStyle}" Margin="2,0,0,8" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="主题" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="浅色为默认；切换立即生效，下次启动保持"
                                               Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource AppButtonStyle}"
                                        Click="ThemeToggle_Click" VerticalAlignment="Center">
                                    <TextBlock x:Name="ThemeToggleText" FontSize="13" />
                                </Button>
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />
                            <Grid Margin="0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="窗口背景" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="云母 / 亚克力 / 纯色，切换立即生效；系统不支持时自动回退"
                                               Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BackdropMicaBtn" Tag="Mica" Content="云母" Click="BackdropButton_Click"
                                            Style="{StaticResource AppButtonStyle}" MinHeight="32" Padding="12,4" FontSize="13" />
                                    <Button x:Name="BackdropAcrylicBtn" Tag="Acrylic" Content="亚克力" Click="BackdropButton_Click"
                                            Style="{StaticResource AppButtonStyle}" MinHeight="32" Padding="12,4" FontSize="13"
                                            Margin="6,0,0,0" />
                                    <Button x:Name="BackdropSolidBtn" Tag="Solid" Content="纯色" Click="BackdropButton_Click"
                                            Style="{StaticResource AppButtonStyle}" MinHeight="32" Padding="12,4" FontSize="13"
                                            Margin="6,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 托盘与启动 -->
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="托盘与启动" Style="{StaticResource SectionTitleStyle}" Margin="2,0,0,8" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="开机自动启动" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="写入当前用户启动项（HKCU Run），开机静默启动常驻程序，不弹任何窗口"
                                               Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" x:Name="AutostartToggle"
                                              Style="{StaticResource SwitchStyle}"
                                              Click="AutostartToggle_Click" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 日志 -->
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="日志" Style="{StaticResource SectionTitleStyle}" Margin="2,0,0,8" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="打开日志目录" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="%APPDATA%\ToolDock\logs（按天滚动）"
                                               Style="{StaticResource RowDescStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource AppButtonStyle}" Click="OpenLogs_Click" MinHeight="32" Padding="12,4" FontSize="13">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8B7;" Style="{StaticResource GlyphTextBlockStyle}" FontSize="13"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="打开目录" Margin="7,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource AppButtonStyle}" Click="ClearLogs_Click" MinHeight="32" Padding="12,4" FontSize="13"
                                            Margin="6,0,0,0">
                                        <TextBlock Text="清空日志" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
