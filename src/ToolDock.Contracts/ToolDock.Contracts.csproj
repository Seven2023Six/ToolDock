<Project Sdk="Microsoft.NET.Sdk">

  <!-- 契约 UI 层：界面插件由按需启动的 WPF App 加载（JIT，DLL 即插即用）。 -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ToolDock.Abstractions\ToolDock.Abstractions.csproj" />
  </ItemGroup>

</Project>
